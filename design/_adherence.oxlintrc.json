{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/layout/**",
              "components/money/**",
              "components/people/**",
              "components/send/**",
              "ui_kits/wren/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter Tight|Roboto Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter Tight, Roboto Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|cents|color|style|key|ref|className|style|children)$/]",
        "message": "<BigNumber> doesn't accept that prop. Declared props: value, size, cents, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigNumber'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:total|amount)$/]",
        "message": "<BigNumber> size must be one of 'total' | 'amount'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|full|disabled|icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, full, disabled, icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Change'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|style|key|ref|className|style|children)$/]",
        "message": "<Change> doesn't accept that prop. Declared props: value, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeeLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|pay|style|key|ref|className|style|children)$/]",
        "message": "<FeeLine> doesn't accept that prop. Declared props: amount, pay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeeLine'] > JSXAttribute[name.name='pay'] > Literal[value!=/^(?:applepay|card)$/]",
        "message": "<FeeLine> pay must be one of 'applepay' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Keypad'] > JSXAttribute > JSXIdentifier[name!=/^(?:onKey|keyHeight|style|key|ref|className|style|children)$/]",
        "message": "<Keypad> doesn't accept that prop. Declared props: onKey, keyHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PayChoice'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<PayChoice> doesn't accept that prop. Declared props: value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PayChoice'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:applepay|card)$/]",
        "message": "<PayChoice> value must be one of 'applepay' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hasWren|selected|size|onClick|key|ref|className|style|children)$/]",
        "message": "<PersonTile> doesn't accept that prop. Declared props: name, hasWren, selected, size, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Phone'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|style|key|ref|className|style|children)$/]",
        "message": "<Phone> doesn't accept that prop. Declared props: children, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinnedAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<PinnedAction> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Presets'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Presets> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StockList'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<StockList> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StockPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:stocks|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<StockPicker> doesn't accept that prop. Declared props: stocks, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StockRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|ticker|value|change|last|onClick|key|ref|className|style|children)$/]",
        "message": "<StockRow> doesn't accept that prop. Declared props: name, ticker, value, change, last, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wren'] > JSXAttribute > JSXIdentifier[name!=/^(?:pose|size|src|flip|style|title|key|ref|className|style|children)$/]",
        "message": "<Wren> doesn't accept that prop. Declared props: pose, size, src, flip, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wren'] > JSXAttribute[name.name='pose'] > Literal[value!=/^(?:perch|point|carry|cheer)$/]",
        "message": "<Wren> pose must be one of 'perch' | 'point' | 'carry' | 'cheer'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
