{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_WREN_API_HOST": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_WREN_API_HOST": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WREN_API_HOST": ""
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "app.basemate.wren"
      }
    }
  }
}
