{
  "name": "@basemate/core",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "echo 'core runs on bun, no build step'",
    "test": "vitest run",
    "eval:routing": "bun --env-file=../../apps/basemate-tba/.env src/discovery/eval/run-routing-eval.ts",
    "eval:conversation": "bun --env-file=../../apps/basemate-tba/.env src/discovery/eval/live-conversation.ts",
    "eval:judge": "bun --env-file=../../apps/basemate-tba/.env src/discovery/eval/conversation-judge.ts",
    "gen:keys": "bunx @xmtp/cli@0.0.4 keys",
    "revoke": "bunx @xmtp/cli@0.0.4 revoke",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun src/db/migrate.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "@basemate/bankr-client": "workspace:*",
    "@basemate/shared": "workspace:*",
    "@coinbase/cdp-sdk": "^1.51.0",
    "@fontsource/inter": "^5.2.8",
    "@langchain/core": "^1.1.12",
    "@langchain/openai": "^1.2.1",
    "@moonwell-fi/moonwell-sdk": "^0.15.0",
    "@photon-ai/advanced-imessage": "0.11.2",
    "@photon-ai/whatsapp-business": "^0.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^10.62.0",
    "@toon-format/toon": "^2.1.0",
    "@types/pg": "^8.18.0",
    "@whetstone-research/doppler-sdk": "^1.0.36",
    "@xmtp/agent-sdk": "^1.2.4",
    "@xmtp/content-type-markdown": "^1.0.0",
    "@xmtp/content-type-reaction": "^2.0.2",
    "@xmtp/content-type-wallet-send-calls": "^2.0.0",
    "bullmq": "^5.34.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ioredis": "^5.4.2",
    "langchain": "^1.2.7",
    "nodemailer": "^9.0.1",
    "openai": "^6.27.0",
    "pg": "^8.20.0",
    "pino": "^10.1.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.7",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "spectrum-ts": "^1.18.0",
    "viem": "^2.46.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.11",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/sharp": "^0.32.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
